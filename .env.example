# agent-observer 환경 변수 예시. 값은 비워 두고 .env.local(커밋 안 됨)에 넣는다.
# 수집 Bearer 토큰. 16자 이상. 예: openssl rand -hex 32
OBSERVER_TOKEN=
# 로그인 비밀번호
OBSERVER_PASSWORD=
# 쿠키 서명 키(선택, 32자 이상 권장. 없으면 비밀번호에서 파생)
OBSERVER_SESSION_SECRET=
# 저장소 구현: file(기본) | memory
OBSERVER_STORE=
# 파일 저장소 폴더(기본 ./.data)
OBSERVER_DATA_DIR=
# 역할·캐릭터 설정 폴더(기본 ./characters)
OBSERVER_CHARACTERS_DIR=
